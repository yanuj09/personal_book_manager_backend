# Copy this file to `.env` and fill in the values before running the server.

# Port the API listens on
PORT=4000

# development | production
NODE_ENV=development

# MongoDB connection string (local or MongoDB Atlas)
# Local:  mongodb://127.0.0.1:27017/personal_book_manager
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/personal_book_manager
MONGODB_URI=mongodb://127.0.0.1:27017/personal_book_manager

# Secret used to sign JWTs. Generate a strong one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# How long a login stays valid (e.g. 15m, 12h, 7d)
JWT_EXPIRES_IN=7d

# Front-end origin(s) allowed to call this API with credentials.
# Comma-separate for multiple, e.g. http://localhost:3000,https://your-app.vercel.app
CLIENT_ORIGIN=http://localhost:3000
